# Copy to .env and adjust. All values have working defaults in config.py.

APP_NAME=pricecalc
DEBUG=false

API_HOST=127.0.0.1
API_PORT=8000

# JSON list of allowed browser origins. Add deployed origins rather than using "*".
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Fixed seed keeps the simulated market-data feed reproducible across runs.
SIM_SEED=42
